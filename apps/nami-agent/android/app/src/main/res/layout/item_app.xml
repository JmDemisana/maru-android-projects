<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="122dp"
    android:orientation="vertical"
    android:background="@drawable/bg_catalog_card"
    android:padding="18dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:scaleType="centerInside"
            android:background="@drawable/bg_catalog_icon"
            android:padding="11dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F7FF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/app_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A3B7D7"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="1dp" />

            <TextView
                android:id="@+id/app_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#99A8C4"
                android:textSize="12sp" />

        </LinearLayout>

        <Button
            android:id="@+id/download_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get"
            android:textColor="#F4F7FF"
            android:background="@drawable/bg_catalog_action"
            android:textAllCaps="false"
            android:minWidth="104dp"
            android:minHeight="46dp"
            android:paddingHorizontal="18dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/app_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progressTint="#7A9BFF"
        android:indeterminateTint="#7A9BFF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/app_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#99A8C4"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
